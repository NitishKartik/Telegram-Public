# Device credentials directory (never leak API keys, tokens, or hashes)
credentials/*
!credentials/README.md
*.json.creds
*.token
*.key
*.pem
*.cert
*.p12
telegram_creds.json
cronjob_creds.json

# Telethon Sessions & Sensitive Data (Protect real session credentials from leaking)
*.session*
*.session
*.session-journal
Session/
Session/*
data/sessions/
data/dead_sessions/
Dead/

# Fleet Web Portal & Database (Reserved for local testing until fully ready)
web/
database/
config/backups/
config/portal_settings.json
config/sync_targets.json

# Local backups, scratch scripts & temporary files
backups/
cron-job/
scripts/
*.tmp
*.bak
*.swp
*~
*.orig

# Test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editor directories
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

